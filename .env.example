# Your GitHub Enterprise Server host (the /api/v3 suffix is added for you)
GHES_BASE_URL=https://github.your-company.internal

# Personal access token. Read-only is enough: classic "repo" scope,
# or fine-grained "Contents: read" + "Metadata: read".
GHES_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Optional: the spec repo to use when a tool call doesn't name one
GHES_DEFAULT_OWNER=
GHES_DEFAULT_REPO=

# Optional: path to your corporate root CA bundle (PEM) if TLS fails
GHES_CA_BUNDLE=
# GHES_VERIFY_SSL=true

# Optional tuning
# GHES_TIMEOUT=30
# GHES_MAX_CONCURRENCY=8
